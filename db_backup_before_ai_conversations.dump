-- Name: hesabpay_hesabpaywebhookevent; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.hesabpay_hesabpaywebhookevent (
    id bigint NOT NULL,
    status character varying(32) NOT NULL,
    signature text NOT NULL,
    "timestamp" character varying(64) NOT NULL,
    transaction_id character varying(100) NOT NULL,
    user_id character varying(50) NOT NULL,
    verified boolean NOT NULL,
    is_duplicate boolean NOT NULL,
    raw_payload jsonb NOT NULL,
    error_message text NOT NULL,
    created_at timestamp with time zone NOT NULL,
    processed_at timestamp with time zone,
    payment_id bigint
);


ALTER TABLE public.hesabpay_hesabpaywebhookevent OWNER TO postgres;

